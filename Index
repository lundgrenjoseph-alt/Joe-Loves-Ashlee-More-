<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ashlee's Love Algorithm ❤️</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: linear-gradient(135deg, #ff758c 0%, #ff7eb3 100%);
      color: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      text-align: center;
    }
    .card {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      padding: 2.5rem;
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
      max-width: 400px;
      width: 90%;
    }
    h1 { margin-top: 0; font-size: 1.8rem; }
    input {
      width: 80%;
      padding: 12px;
      font-size: 1.1rem;
      border: none;
      border-radius: 10px;
      margin: 15px 0;
      text-align: center;
    }
    button {
      background: #fff;
      color: #ff4b72;
      border: none;
      padding: 12px 24px;
      font-size: 1.1rem;
      font-weight: bold;
      border-radius: 10px;
      cursor: pointer;
      transition: transform 0.2s;
    }
    button:hover { transform: scale(1.05); }
    #result {
      margin-top: 20px;
      font-size: 1.2rem;
      font-weight: bold;
      min-height: 75px;
      line-height: 1.5;
    }
    .win-banner {
      display: block;
      font-size: 1.6rem;
      margin-top: 8px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>❤️ Ashlee's Love Calculator ❤️</h1>
    <p>Hey Ashlee, enter how much you love me:</p>
    <input type="number" id="gfLove" placeholder="Enter any number..." />
    <br>
    <button onclick="calculateLove()">Run Algorithm</button>
    <div id="result"></div>
  </div>

  <script>
    function calculateLove() {
      const input = document.getElementById('gfLove').value;
      const resultDiv = document.getElementById('result');
      const ashleeAmount = Number(input);

      if (input === "" || isNaN(ashleeAmount)) {
        resultDiv.innerHTML = "Error: Come on Ashlee, enter a number first! 😘";
        return;
      }

      if (ashleeAmount <= 0) {
        resultDiv.innerHTML = `Ashlee's love: ${ashleeAmount}<br>My love for Ashlee: ∞ (Infinity)<span class="win-banner">I win! 🏆❤️</span>`;
      } else {
        const myLove = BigInt(Math.floor(ashleeAmount)) + 1n;
        resultDiv.innerHTML = `Ashlee loves me: ${ashleeAmount.toLocaleString()}<br>I love Ashlee: ${myLove.toLocaleString()}<span class="win-banner">I win! 🏆💖</span>`;
      }
    }
  </script>
</body>
</html>
